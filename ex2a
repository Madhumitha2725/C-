using System;

class Program
{
    static void Swap(ref int a, ref int b)
    {
        int temp = a;
        a = b;
        b = temp;
    }

    static void Main()
    {
        int a = 10, b = 20;

        Console.WriteLine("Before Swap: a = " + a + ", b = " + b);

        Swap(ref a, ref b);

        Console.WriteLine("After Swap: a = " + a + ", b = " + b);
    }
}
Output
Before Swap: a = 10, b = 20
After Swap: a = 20, b = 10
